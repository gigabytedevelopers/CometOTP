<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="GoogleAppIndexingWarning"
    android:installLocation="auto">

    <uses-sdk tools:overrideLibrary="com.google.zxing.client.android" />

    <!-- Android 13+ (API 33): notifications are only shown once the user has granted this
         runtime permission. It is requested when backup broadcasts are enabled in the settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Backups to Google Drive. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:backupAgent="com.gigabytedevelopersinc.app.cometOTP.Utilities.BackupAgent"
        android:fullBackupOnly="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme"
        tools:targetApi="tiramisu">

        <!-- Every screen with a UI is portrait-only on phones, whatever the system auto-rotate
             setting. Android 16+ ignores the lock on large screens (tablets, unfolded foldables),
             so the landscape layouts and the state kept across recreation are still needed there.
             The invisible Theme.NoDisplay screens are left out: they never draw. -->
        <activity
            android:name="com.gigabytedevelopersinc.app.cometOTP.Activities.MainActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CometOTP.Splash"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard">
            <!-- MAIN/LAUNCHER lives on the aliases below so the icon can be switched. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="otpauth"/>
                <data android:host="totp"/>
                <data android:host="hotp"/>
            </intent-filter>
            <intent-filter>
                <action android:name="com.gigabytedevelopersinc.app.cometOTP.intent.SCAN_QR" />
                <action android:name="com.gigabytedevelopersinc.app.cometOTP.intent.IMPORT_QR" />
                <action android:name="com.gigabytedevelopersinc.app.cometOTP.intent.ENTER_DETAILS" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="gigabytedevelopers.com"
                    android:pathPattern="/apps/cometOTP" />
            </intent-filter>
        </activity>

        <!-- Selectable launcher icons: exactly one alias is enabled at a time. -->
        <activity-alias
            android:name="com.gigabytedevelopersinc.app.cometOTP.Launcher.Blue"
            android:targetActivity="com.gigabytedevelopersinc.app.cometOTP.Activities.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_blue_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name="com.gigabytedevelopersinc.app.cometOTP.Launcher.Mono"
            android:targetActivity="com.gigabytedevelopersinc.app.cometOTP.Activities.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mono"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_mono_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name="com.gigabytedevelopersinc.app.cometOTP.Launcher.White"
            android:targetActivity="com.gigabytedevelopersinc.app.cometOTP.Activities.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_white"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_white_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name="com.gigabytedevelopersinc.app.cometOTP.Launcher.Classic"
            android:targetActivity="com.gigabytedevelopersinc.app.cometOTP.Activities.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_classic"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_classic_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity
            android:name=".Activities.AboutActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.MainActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.AuthenticateActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.MainActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.BackupActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.MainActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.ScheduledBackupActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.BackupActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.CacheActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.SettingsActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.IntroScreenActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.MainActivity"
            android:theme="@style/Theme.Intro.Solid" />
        <activity
            android:name=".Activities.LicensesActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.AboutActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.PrivacyPolicyActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.AboutActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.SettingsActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.MainActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.SecurityActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.MainActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.AuthSetupActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.SecurityActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.SupportActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.MainActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.FaqDetailActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.SupportActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.ContactActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.SupportActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.ConnectedExtensionsActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.SecurityActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.PairBrowserActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.ConnectedExtensionsActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.RemovedAccountsActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.MainActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.TagsActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.MainActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.ScanActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.MainActivity"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- Puts CometOTP on the share sheet for images: a QR code screenshot or a photo of one.
             The share sheet starts its target in the sharing app's task, so this invisible screen
             takes the images and forwards them to the main screen in CometOTP's own task (see
             ShareReceiverActivity), instead of a second main screen appearing over the gallery. -->
        <activity
            android:name=".Activities.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Activities.ImportScanActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".Activities.MainActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Activities.PanicResponderActivity"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:exported="false">
            <intent-filter>
                <action android:name="info.guardianproject.panic.action.TRIGGER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver android:name=".Receivers.PlainTextBackupBroadcastReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gigabytedevelopersinc.app.cometOTP.broadcast.PLAIN_TEXT_BACKUP" />
            </intent-filter>
        </receiver>

        <receiver android:name=".Receivers.EncryptedBackupBroadcastReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gigabytedevelopersinc.app.cometOTP.broadcast.ENCRYPTED_BACKUP" />
            </intent-filter>
        </receiver>
        <!-- Hands a backup written for sharing to the app it is shared with (BackupActivity) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.backupshare"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/backup_share_paths" />
        </provider>
    </application>

    <!-- Required on Android 11+ for andOTP to be able to select a PGP provider -->
    <queries>
        <package android:name="org.sufficientlysecure.keychain" />

        <!-- Browsers that can show a Custom Tab. From Android 11 an app cannot see other apps
             unless it declares them here, so without these the custom tabs helper found no
             browser at all and always opened links in its bare WebView fallback. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>