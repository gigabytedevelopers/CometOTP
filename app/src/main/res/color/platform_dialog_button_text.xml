<?xml version="1.0" encoding="utf-8"?>
<!-- Buttons of framework (android.app) dialogs on the light themes; see btn_text_text for why a
     disabled button needs its own colour. colorForeground rather than colorOnSurface, which the
     framework dialog themes do not define. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.38" android:color="?android:attr/colorForeground" android:state_enabled="false" />
    <item android:color="@color/primary_800" />
</selector>
