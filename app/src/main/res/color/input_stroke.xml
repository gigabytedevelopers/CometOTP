<?xml version="1.0" encoding="utf-8"?>
<!-- A text field's outline: the primary colour while it has focus, otherwise a quiet grey that
     still shows on the background behind it (colorInputStroke, set per theme). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorPrimary" android:state_focused="true" />
    <item android:color="?attr/colorInputStroke" />
</selector>
