<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="InkPageIndicator">
        <attr name="dotDiameter" format="dimension" />
        <attr name="dotGap" format="dimension" />
        <attr name="animationDuration" format="integer" />
        <attr name="pageIndicatorColor" format="color" />
        <attr name="currentPageIndicatorColor" format="color" />
    </declare-styleable>

    <declare-styleable name="ParallaxLayout_Layout">
        <attr name="layout_parallaxFactor" format="float" />
    </declare-styleable>

    <declare-styleable name="NumberPickerPreference">
        <attr name="minValue" format="integer|reference"/>
        <attr name="maxValue" format="integer|reference"/>
        <attr name="wrapSelectorWheel" format="boolean"/>
    </declare-styleable>

    <declare-styleable name="CountdownRingView">
        <attr name="ringColor" format="color|reference" />
        <attr name="ringExpiringColor" format="color|reference" />
        <attr name="ringTrackColor" format="color|reference" />
        <attr name="ringTextColor" format="color|reference" />
        <attr name="ringStrokeWidth" format="dimension" />
        <attr name="ringTextSize" format="dimension" />
        <attr name="ringShowText" format="boolean" />
        <attr name="ringHighlightExpiring" format="boolean" />
        <attr name="ringExpiringThreshold" format="integer" />
    </declare-styleable>
    <declare-styleable name="NotchedBottomBar">
        <attr name="barColor" format="color|reference" />
        <attr name="barLineColor" format="color|reference" />
        <attr name="barLineWidth" format="dimension" />
        <attr name="barNotchRadius" format="dimension" />
    </declare-styleable>
</resources>