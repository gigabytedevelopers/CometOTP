    <dimen name="sheet_handle_height">5dp</dimen>
    <item name="sheet_scrim" type="dimen" format="float">0.6</item>

    <!-- Bottom sheets follow Material 3.

         A list of actions is laid out like a navigation drawer: 56dp rows inset 12dp from the
         sheet's edges, each with its icon and text 16dp inside it and nothing between rows, so the
         pressed and selected fill floats clear of the screen edge.

         Forms and messages keep the 16dp margin a phone layout has on each side, 16dp between
         fields, 8dp between a label and what it labels, 24dp between sections and above the main
         action, and 8dp between stacked buttons. -->
    <dimen name="nav_row_height">56dp</dimen>
    <dimen name="sheet_list_inset">12dp</dimen>
    <dimen name="import_flow_icon_size">56dp</dimen><!-- sheet_import_file: app -> CometOTP -->
    <!-- The scanner's viewfinder corners (ViewfinderView) -->
    <dimen name="scan_corner_length">64dp</dimen>
    <dimen name="scan_corner_stroke">3dp</dimen>
    <dimen name="scan_corner_radius">24dp</dimen>
    <dimen name="sheet_side_padding">@dimen/space_md</dimen>
    <dimen name="sheet_header_gap">@dimen/space_sm</dimen><!-- the 48dp title row to the first item -->
    <dimen name="sheet_field_gap">@dimen/space_md</dimen>
    <dimen name="sheet_label_gap">@dimen/space_sm</dimen>
    <dimen name="sheet_section_gap">@dimen/space_lg</dimen>
    <dimen name="sheet_button_gap">@dimen/space_sm</dimen>
    <dimen name="input_vertical_padding">16dp</dimen>
    <dimen name="input_horizontal_padding">16dp</dimen>
    <dimen name="thumbnail_tile_size">68dp</dimen>
    <dimen name="thumbnail_tile_radius">16dp</dimen>

    <dimen name="card_side_margin">8dp</dimen>
    <!-- The trailing column (component_card): the copy icon sits card_copy_icon_inset inside its
         button, so 7dp + 9dp puts it 16dp from the card's edge, as the thumbnail is from its
         start (space_md); the countdown and counter are centred over it -->
    <dimen name="card_trailing_margin">7dp</dimen>
    <dimen name="card_copy_icon_inset">9dp</dimen>
    <dimen name="card_vertical_margin">3dp</dimen><!-- the spacing the previous app used -->
    <dimen name="token_line_height">40dp</dimen>
    <dimen name="card_corner_radius">12dp</dimen>
    <dimen name="card_selected_stroke">2dp</dimen>
    <!-- Theme and list style pickers (TilePickerPreference) -->
    <dimen name="tile_preview_width">72dp</dimen>
    <dimen name="tile_preview_height">120dp</dimen>
    <dimen name="tile_selected_stroke">2dp</dimen><!-- a selected card in manage mode -->
    <dimen name="card_padding_without_corners">14dp</dimen>
    <dimen name="card_thumbnail_size">44dp</dimen>
    <!-- As tall as a card showing an issuer, a token and a label (12 + 16 + 30 + 16 + 12dp, measured
         at 242px on a 450dpi phone), so a card missing a line is no shorter than one that has them
         all, and the 72dp column of menu and copy buttons stays 7dp clear of the card's edges. At
         72dp the two buttons ran from the top edge to the bottom one. -->
    <dimen name="card_min_height">86dp</dimen>

    <!-- The default letter tile text size (relative to the height of the tile) -->
    <item name="tile_letter_font_size_scale" type="dimen" format="float">0.75</item>

    <dimen name="drawer_width">250dp</dimen>
    <dimen name="tag_filter_max_height">320dp</dimen>
    <dimen name="divider_size">1dp</dimen>

