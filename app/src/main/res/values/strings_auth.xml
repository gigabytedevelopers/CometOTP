<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="auth_activity_title">Authenticate</string>

    <!-- Hints -->
    <string name="auth_hint_password">Password</string>
    <string name="auth_hint_pin">PIN</string>

    <!-- Messages -->
    <string name="auth_msg_authenticate">Please authenticate to start CometOTP!</string>
    <string name="auth_msg_confirm_encryption">Please confirm your authentication to generate the
        new encryption key!</string>

    <!-- Titles -->
    <string name="auth_title_password">Enter your Password</string>
    <string name="auth_title_pin">Enter your PIN</string>

    <!-- Buttons -->
    <string name="auth_button_unlock">Unlock</string>
    <string name="auth_button_confirm">Confirm</string>

    <!-- PIN keypad -->
    <string name="auth_pin_key_backspace">Delete</string>
    <string name="auth_pin_key_clear">Clear PIN</string>
    <string name="auth_pin_key_confirm">OK</string>
    <!-- Biometric unlock, instead of the PIN or password -->
    <string name="auth_biometric_key">Unlock with biometrics</string>
    <plurals name="auth_pin_dots_progress">
        <item quantity="one">%1$d of %2$d digit entered</item>
        <item quantity="other">%1$d of %2$d digits entered</item>
    </plurals>
    <plurals name="auth_pin_dots_count">
        <item quantity="one">%1$d digit entered</item>
        <item quantity="other">%1$d digits entered</item>
    </plurals>

    <!-- Wrong passwords and PINs, see UnlockThrottle -->
    <string name="auth_error_wrong_pin">Wrong PIN</string>
    <string name="auth_error_wrong_password">Wrong password</string>
    <plurals name="auth_status_attempts_left">
        <item quantity="one">%d attempt left</item>
        <item quantity="other">%d attempts left</item>
    </plurals>
    <string name="auth_status_next_lockout_pin">Another wrong PIN locks CometOTP for %s</string>
    <string name="auth_status_next_lockout_password">Another wrong password locks CometOTP for %s</string>
    <string name="auth_status_locked">Too many wrong attempts. Try again in %s</string>
    <plurals name="auth_duration_seconds">
        <item quantity="one">%d second</item>
        <item quantity="other">%d seconds</item>
    </plurals>
    <plurals name="auth_duration_minutes">
        <item quantity="one">%d minute</item>
        <item quantity="other">%d minutes</item>
    </plurals>

    <!-- Toast messages -->
    <string name="auth_toast_password_missing">Please set a password in the <b>Settings</b>!</string>
    <string name="auth_toast_pin_missing">Please set a PIN in the <b>Settings</b>!</string>
    <string name="auth_toast_password_again">Wrong password, please try again!</string>
    <string name="auth_toast_pin_again">Wrong PIN, please try again!</string>
</resources>