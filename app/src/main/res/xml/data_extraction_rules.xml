<?xml version="1.0" encoding="utf-8"?>
<!-- Android's backup and device-to-device transfer, from Android 12: everything as before,
     except the removed accounts (RecycleBin), which backups leave out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="removed.dat" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="removed.dat" />
    </device-transfer>
</data-extraction-rules>
