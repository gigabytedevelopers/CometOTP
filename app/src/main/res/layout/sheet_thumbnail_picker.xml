<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_md"
    android:paddingEnd="@dimen/space_md">

    <View style="@style/Widget.Comet.SheetHandle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_sm">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/menu_popup_change_image"
            android:textAppearance="@style/TextAppearance.Comet.SheetTitle" />

        <ImageButton
            android:id="@+id/sheetClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@android:string/cancel"
            app:srcCompat="@drawable/ic_close"
            app:tint="?attr/colorOnSurface" />

    </FrameLayout>

    <EditText
        android:id="@+id/thumbnail_search"
        style="@style/Widget.Comet.PillField"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/space_sm"
        android:autofillHints="no"
        android:drawablePadding="@dimen/space_sm"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        app:drawableStartCompat="@drawable/ic_search"
        app:drawableTint="?attr/colorOnSurfaceVariant" />

    <GridView
        android:id="@+id/thumbnail_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:horizontalSpacing="@dimen/space_md"
        android:numColumns="auto_fit"
        android:paddingBottom="@dimen/space_lg"
        android:stretchMode="columnWidth"
        android:verticalSpacing="@dimen/space_md" />

</LinearLayout>
