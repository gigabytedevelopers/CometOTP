<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/sheet_side_padding"
    android:paddingEnd="@dimen/sheet_side_padding">

    <View style="@style/Widget.Comet.SheetHandle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_sm">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/menu_popup_change_image"
            android:textAppearance="@style/TextAppearance.Comet.SheetTitle" />

        <ImageButton
            android:id="@+id/sheetClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@android:string/cancel"
            app:srcCompat="@drawable/ic_close"
            app:tint="?attr/colorOnSurface" />

    </FrameLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sheet_header_gap"
        android:hint="@string/search_hint"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/thumbnail_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="no"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <GridView
        android:id="@+id/thumbnail_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/sheet_field_gap"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:horizontalSpacing="@dimen/space_md"
        android:numColumns="auto_fit"
        android:paddingBottom="@dimen/space_lg"
        android:stretchMode="columnWidth"
        android:verticalSpacing="@dimen/space_md" />

</LinearLayout>
