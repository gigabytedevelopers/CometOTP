<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_lg">

        <include
            android:id="@+id/row_pin"
            layout="@layout/item_setting_row" />

        <View style="@style/Widget.Comet.Divider" />

        <include
            android:id="@+id/row_password"
            layout="@layout/item_setting_row" />

        <View style="@style/Widget.Comet.Divider" />

        <include
            android:id="@+id/row_device"
            layout="@layout/item_setting_row" />

        <View style="@style/Widget.Comet.Divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/security_remove"
            style="@style/Widget.Comet.Button.Text.Danger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/security_remove_protection"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
