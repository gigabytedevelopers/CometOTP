<?xml version="1.0" encoding="utf-8"?>
<!-- Tag filter, shown as a bottom sheet like every other menu in the app -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/sheet_row_inset"
    android:paddingEnd="@dimen/sheet_row_inset"
    android:paddingBottom="@dimen/space_lg">

    <View style="@style/Widget.Comet.SheetHandle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md">

        <ImageView
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_tag"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tags_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:text="@string/label_filter_by_tags"
            android:textAppearance="@style/TextAppearance.Comet.SheetTitle" />

    </LinearLayout>

    <CheckedTextView
        android:id="@+id/all_tags_in_drawer"
        style="@style/Widget.Comet.TagFilterRow"
        android:text="@string/button_all_tags" />

    <CheckedTextView
        android:id="@+id/no_tags_entries"
        style="@style/Widget.Comet.TagFilterRow"
        android:text="@string/button_no_tags" />

    <View
        style="@style/Widget.Comet.Divider"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginEnd="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_xs" />

    <ListView
        android:id="@+id/tags_list_in_drawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@null"
        android:footerDividersEnabled="false"
        android:headerDividersEnabled="false" />

</LinearLayout>
