<?xml version="1.0" encoding="utf-8"?>
<!-- Import from Google Authenticator: how to export there, then two ways to read the codes here. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sheet_side_padding"
        android:paddingEnd="@dimen/sheet_side_padding"
        android:paddingBottom="@dimen/space_lg">

        <View style="@style/Widget.Comet.SheetHandle" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_sm">

            <!-- Kept clear of the close button on both sides so the title stays centred. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/import_google_auth_title"
                android:textAppearance="@style/TextAppearance.Comet.SheetTitle" />

            <ImageButton
                android:id="@+id/sheetClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@android:string/cancel"
                app:srcCompat="@drawable/ic_close"
                app:tint="?attr/colorOnSurface" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_header_gap"
            android:background="@drawable/bg_info_panel"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_google_auth_steps_heading"
                android:textAppearance="@style/TextAppearance.Comet.TitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout style="@style/Widget.Comet.ImportStep">

                <TextView
                    style="@style/Widget.Comet.ImportStepNumber"
                    android:text="1"
                    tools:ignore="HardcodedText" />

                <TextView
                    style="@style/Widget.Comet.ImportStepText"
                    android:text="@string/import_google_auth_step_1" />

            </LinearLayout>

            <LinearLayout style="@style/Widget.Comet.ImportStep">

                <TextView
                    style="@style/Widget.Comet.ImportStepNumber"
                    android:text="2"
                    tools:ignore="HardcodedText" />

                <TextView
                    style="@style/Widget.Comet.ImportStepText"
                    android:text="@string/import_google_auth_step_2" />

            </LinearLayout>

            <LinearLayout style="@style/Widget.Comet.ImportStep">

                <TextView
                    style="@style/Widget.Comet.ImportStepNumber"
                    android:text="3"
                    tools:ignore="HardcodedText" />

                <TextView
                    style="@style/Widget.Comet.ImportStepText"
                    android:text="@string/import_google_auth_step_3" />

            </LinearLayout>

        </LinearLayout>

        <!-- Shown once part of a multi-code export has been scanned. -->
        <TextView
            android:id="@+id/importProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_field_gap"
            android:drawablePadding="@dimen/space_sm"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Comet.TitleSmall"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_qr_code"
            app:drawableTint="?attr/colorPrimary"
            tools:text="1 of 3 codes scanned. Scan the rest to continue."
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importScanCamera"
            style="@style/Widget.Comet.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/sheet_section_gap"
            android:text="@string/import_google_auth_scan"
            app:icon="@drawable/ic_qr_scanner"
            app:iconGravity="textStart" />

        <!-- Filled like the camera button: the two are alternatives of equal weight, and a
             lighter treatment for this one read as disabled. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/importChooseImages"
            style="@style/Widget.Comet.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/sheet_button_gap"
            android:text="@string/import_google_auth_images"
            app:icon="@drawable/ic_image_outline"
            app:iconGravity="textStart" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
