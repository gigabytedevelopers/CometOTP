<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:id="@+id/about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_xl">

        <!-- Brand header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_lg">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                app:srcCompat="@drawable/ic_logo_stacked"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/about_description"
                android:textAppearance="@style/TextAppearance.Comet.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- App -->
        <LinearLayout
            android:id="@+id/about_layout_version"
            style="@style/Widget.Comet.AboutRow">

            <ImageView
                android:id="@+id/aboutImgVersion"
                style="@style/Widget.Comet.AboutRowIcon"
                app:srcCompat="@drawable/ic_info_outline" />

            <LinearLayout
                style="@style/Widget.Comet.AboutRowText">

                <TextView
                    style="@style/Widget.Comet.AboutRowTitle"
                    android:text="@string/about_label_version" />

                <TextView
                    android:id="@+id/about_text_version"
                    style="@style/Widget.Comet.AboutRowSubtitle"
                    tools:text="7.0.2" />

            </LinearLayout>

        </LinearLayout>

        <View style="@style/Widget.Comet.Divider" />

        <LinearLayout
            android:id="@+id/about_layout_changelog"
            style="@style/Widget.Comet.AboutRow">

            <ImageView
                android:id="@+id/aboutImgChangelog"
                style="@style/Widget.Comet.AboutRowIcon"
                app:srcCompat="@drawable/ic_schedule" />

            <LinearLayout style="@style/Widget.Comet.AboutRowText">

                <TextView
                    style="@style/Widget.Comet.AboutRowTitle"
                    android:text="@string/about_label_changelog" />

            </LinearLayout>

            <ImageView style="@style/Widget.Comet.AboutRowChevron" />

        </LinearLayout>

        <View style="@style/Widget.Comet.Divider" />

        <LinearLayout
            android:id="@+id/about_layout_license"
            style="@style/Widget.Comet.AboutRow">

            <ImageView
                android:id="@+id/aboutImgLicense"
                style="@style/Widget.Comet.AboutRowIcon"
                app:srcCompat="@drawable/ic_copyright_gray" />

            <LinearLayout style="@style/Widget.Comet.AboutRowText">

                <TextView
                    style="@style/Widget.Comet.AboutRowTitle"
                    android:text="@string/about_label_license" />

                <TextView
                    style="@style/Widget.Comet.AboutRowSubtitle"
                    android:text="@string/about_label_MIT" />

            </LinearLayout>

            <ImageView style="@style/Widget.Comet.AboutRowChevron" />

        </LinearLayout>

        <View style="@style/Widget.Comet.Divider" />

        <LinearLayout
            android:id="@+id/about_layout_licenses"
            style="@style/Widget.Comet.AboutRow">

            <ImageView
                android:id="@+id/aboutImgOpenSource"
                style="@style/Widget.Comet.AboutRowIcon"
                app:srcCompat="@drawable/ic_label_outline" />

            <LinearLayout style="@style/Widget.Comet.AboutRowText">

                <TextView
                    style="@style/Widget.Comet.AboutRowTitle"
                    android:text="@string/about_label_licenses" />

            </LinearLayout>

            <ImageView style="@style/Widget.Comet.AboutRowChevron" />

        </LinearLayout>

        <View style="@style/Widget.Comet.Divider" />

        <LinearLayout
            android:id="@+id/privacy_policy"
            style="@style/Widget.Comet.AboutRow">

            <ImageView
                style="@style/Widget.Comet.AboutRowIcon"
                app:srcCompat="@drawable/ic_verified_user" />

            <LinearLayout style="@style/Widget.Comet.AboutRowText">

                <TextView
                    style="@style/Widget.Comet.AboutRowTitle"
                    android:text="@string/terms_conditions_about" />

            </LinearLayout>

            <ImageView style="@style/Widget.Comet.AboutRowChevron" />

        </LinearLayout>

        <View style="@style/Widget.Comet.Divider" />

        <!-- Support -->
        <TextView
            style="@style/Widget.Comet.SectionHeader"
            android:text="@string/about_title_support" />

        <LinearLayout
            android:id="@+id/about_layout_bugs"
            style="@style/Widget.Comet.AboutRow">

            <ImageView
                android:id="@+id/aboutImgBugs"
                style="@style/Widget.Comet.AboutRowIcon"
                app:srcCompat="@drawable/ic_bug" />

            <LinearLayout style="@style/Widget.Comet.AboutRowText">

                <TextView
                    style="@style/Widget.Comet.AboutRowTitle"
                    android:text="@string/about_label_report_bugs" />

                <TextView
                    style="@style/Widget.Comet.AboutRowSubtitle"
                    android:text="@string/about_desc_report_bugs" />

            </LinearLayout>

            <ImageView style="@style/Widget.Comet.AboutRowChevron" />

        </LinearLayout>

        <View style="@style/Widget.Comet.Divider" />

        <LinearLayout
            android:id="@+id/about_layout_source"
            style="@style/Widget.Comet.AboutRow">

            <ImageView
                android:id="@+id/aboutImgSource"
                style="@style/Widget.Comet.AboutRowIcon"
                app:srcCompat="@drawable/ic_support" />

            <LinearLayout style="@style/Widget.Comet.AboutRowText">

                <TextView
                    style="@style/Widget.Comet.AboutRowTitle"
                    android:text="@string/about_label_source" />

            </LinearLayout>

            <ImageView style="@style/Widget.Comet.AboutRowChevron" />

        </LinearLayout>

        <View style="@style/Widget.Comet.Divider" />

        <!-- Authors -->
        <TextView
            style="@style/Widget.Comet.SectionHeader"
            android:text="@string/about_title_authors" />

        <LinearLayout style="@style/Widget.Comet.AboutRow">

            <ImageView
                android:id="@+id/aboutImgAuthor1"
                style="@style/Widget.Comet.AboutRowIcon"
                app:srcCompat="@drawable/ic_account_circle_gray" />

            <LinearLayout style="@style/Widget.Comet.AboutRowText">

                <TextView
                    style="@style/Widget.Comet.AboutRowTitle"
                    android:text="@string/about_name_author1" />

                <TextView
                    style="@style/Widget.Comet.AboutRowSubtitle"
                    android:text="@string/about_label_main_author" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/about_author1_github"
                        style="@style/Widget.Comet.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="@dimen/space_sm"
                        android:paddingEnd="@dimen/space_sm"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:text="@string/about_label_github" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/about_author1_paypal"
                        style="@style/Widget.Comet.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="@dimen/space_sm"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="@dimen/space_sm"
                        android:paddingEnd="@dimen/space_sm"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:text="@string/about_label_donate" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <View style="@style/Widget.Comet.Divider" />

        <LinearLayout style="@style/Widget.Comet.AboutRow">

            <ImageView
                android:id="@+id/aboutImgAuthor2"
                style="@style/Widget.Comet.AboutRowIcon"
                app:srcCompat="@drawable/ic_account_circle_gray" />

            <LinearLayout style="@style/Widget.Comet.AboutRowText">

                <TextView
                    style="@style/Widget.Comet.AboutRowTitle"
                    android:text="@string/about_name_author2" />

                <TextView
                    style="@style/Widget.Comet.AboutRowSubtitle"
                    android:text="@string/about_label_original_author_main_google" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/about_author2_app"
                    style="@style/Widget.Comet.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="@dimen/space_sm"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_sm"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:text="@string/about_label_original_app" />

            </LinearLayout>

        </LinearLayout>

        <View style="@style/Widget.Comet.Divider" />

        <!-- Thumbnail disclaimer -->
        <LinearLayout
            android:id="@+id/thumb_expand"
            style="@style/Widget.Comet.AboutRow">

            <ImageView
                style="@style/Widget.Comet.AboutRowIcon"
                app:srcCompat="@drawable/ic_info_outline" />

            <LinearLayout style="@style/Widget.Comet.AboutRowText">

                <TextView
                    style="@style/Widget.Comet.AboutRowTitle"
                    android:text="@string/label_thumb_disclaimer" />

            </LinearLayout>

            <ImageView
                android:id="@+id/thumb_expand_button"
                style="@style/Widget.Comet.AboutRowChevron"
                app:srcCompat="@drawable/ic_expand_more" />

        </LinearLayout>

        <TextView
            android:id="@+id/thumb_disclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_sm"
            android:paddingBottom="@dimen/space_md"
            android:text="@string/thumbnails_disclaimer"
            android:textAppearance="@style/TextAppearance.Comet.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
