<?xml version="1.0" encoding="utf-8"?>
<!-- Options for a single service, opened with a long press on its card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/sheet_list_inset"
    android:paddingEnd="@dimen/sheet_list_inset"
    android:paddingBottom="@dimen/space_lg">

    <View style="@style/Widget.Comet.SheetHandle" />

    <!-- The card itself, kept up to date, so it is clear which service the options are for
         (EntriesCardAdapter.showOptionsSheet) -->
    <FrameLayout
        android:id="@+id/card_options_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_sm" />

    <TextView
        android:id="@+id/card_options_copy"
        style="@style/Widget.Comet.NavRow"
        android:text="@string/menu_popup_copy"
        app:drawableStartCompat="@drawable/ic_copy" />

    <TextView
        android:id="@+id/card_options_select"
        style="@style/Widget.Comet.NavRow"
        android:text="@string/menu_popup_select"
        app:drawableStartCompat="@drawable/ic_checklist" />

    <TextView
        android:id="@+id/card_options_edit"
        style="@style/Widget.Comet.NavRow"
        android:text="@string/menu_popup_edit"
        app:drawableStartCompat="@drawable/ic_edit_pen" />

    <TextView
        android:id="@+id/card_options_image"
        style="@style/Widget.Comet.NavRow"
        android:text="@string/menu_popup_change_image"
        app:drawableStartCompat="@drawable/ic_image_outline" />

    <TextView
        android:id="@+id/card_options_qr"
        style="@style/Widget.Comet.NavRow"
        android:text="@string/menu_popup_show_qr_code"
        app:drawableStartCompat="@drawable/ic_qr_code" />

    <TextView
        android:id="@+id/card_options_pin"
        style="@style/Widget.Comet.NavRow"
        android:text="@string/menu_popup_establish_pin"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_key"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/card_options_keystrokes"
        style="@style/Widget.Comet.NavRow"
        android:text="@string/menu_send_keystrokes"
        app:drawableStartCompat="@drawable/ic_keyboard_hide" />

    <TextView
        android:id="@+id/card_options_remove"
        style="@style/Widget.Comet.NavRow.Destructive"
        android:text="@string/menu_popup_remove"
        app:drawableStartCompat="@drawable/ic_delete_outline" />

</LinearLayout>
