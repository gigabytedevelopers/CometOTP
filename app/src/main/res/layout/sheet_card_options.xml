<?xml version="1.0" encoding="utf-8"?>
<!-- Options for a single service, opened from the card's overflow button -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/sheet_row_inset"
    android:paddingEnd="@dimen/sheet_row_inset"
    android:paddingBottom="@dimen/space_lg">

    <View style="@style/Widget.Comet.SheetHandle" />

    <TextView
        android:id="@+id/card_options_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_xs"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:textAppearance="@style/TextAppearance.Comet.TitleMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="1&amp;1" />

    <TextView
        android:id="@+id/card_options_edit"
        style="@style/Widget.Comet.NavRow"
        android:text="@string/menu_popup_edit"
        app:drawableStartCompat="@drawable/ic_edit_pen" />

    <TextView
        android:id="@+id/card_options_image"
        style="@style/Widget.Comet.NavRow"
        android:text="@string/menu_popup_change_image"
        app:drawableStartCompat="@drawable/ic_image_outline" />

    <TextView
        android:id="@+id/card_options_qr"
        style="@style/Widget.Comet.NavRow"
        android:text="@string/menu_popup_show_qr_code"
        app:drawableStartCompat="@drawable/ic_qr_code" />

    <TextView
        android:id="@+id/card_options_pin"
        style="@style/Widget.Comet.NavRow"
        android:text="@string/menu_popup_establish_pin"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_key"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/card_options_keystrokes"
        style="@style/Widget.Comet.NavRow"
        android:text="@string/menu_send_keystrokes"
        app:drawableStartCompat="@drawable/ic_keyboard_hide" />

    <TextView
        android:id="@+id/card_options_remove"
        style="@style/Widget.Comet.NavRow.Destructive"
        android:text="@string/menu_popup_remove"
        app:drawableStartCompat="@drawable/ic_delete_outline" />

</LinearLayout>
