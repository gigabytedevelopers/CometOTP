<?xml version="1.0" encoding="utf-8"?>
<!-- Unlocking with a PIN: dots for the digits typed and a keypad, no text field or keyboard. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/authenticate"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_lg"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/space_lg"
    android:paddingBottom="@dimen/space_lg">

    <TextView
        android:id="@+id/passwordTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/auth_title_pin"
        android:textAppearance="@style/TextAppearance.Comet.TitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/passwordLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:text="@string/auth_msg_authenticate"
        android:textAppearance="@style/TextAppearance.Comet.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.gigabytedevelopersinc.app.cometOTP.View.PinDotsView
        android:id="@+id/pinDots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Wrong attempts and lockouts, see AuthenticateActivity.showUnlockStatus(). -->
    <TextView
        android:id="@+id/authStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="center"
        android:minLines="2"
        android:textAppearance="@style/TextAppearance.Comet.BodySmall"
        android:textColor="?attr/colorError" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.gigabytedevelopersinc.app.cometOTP.View.PinPadView
        android:id="@+id/pinPad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
