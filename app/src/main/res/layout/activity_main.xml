<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context="com.gigabytedevelopersinc.app.cometOTP.Activities.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_bar_height"
            android:background="?android:attr/colorBackground"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Default: centred brand + global countdown -->
                <ImageView
                    android:id="@+id/appBarBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    app:srcCompat="@drawable/ic_logo_horizontal"
                    app:tint="?attr/colorOnSurface" />

                <!-- Also stays up in search mode while there are results; the search bar's end
                     padding then makes room for it (MainActivity.updateAppBarCountdown). -->
                <com.gigabytedevelopersinc.app.cometOTP.View.CountdownRingView
                    android:id="@+id/appBarCountdown"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/space_md"
                    app:ringTextSize="10sp" />

                <!-- Search mode: back arrow + pill field -->
                <LinearLayout
                    android:id="@+id/appBarSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_md"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageButton
                        android:id="@+id/searchBack"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/button_close_search"
                        app:srcCompat="@drawable/ic_arrow_back"
                        app:tint="?attr/colorOnSurface" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <EditText
                            android:id="@+id/searchField"
                            style="@style/Widget.Comet.PillField"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:autofillHints="no"
                            android:hint="@string/search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingEnd="44dp"
                            tools:ignore="RtlSymmetry" />

                        <!-- Bounded ripple, not borderless: a borderless one is drawn on the
                             toolbar behind the pill. Hidden while the field is empty. -->
                        <ImageButton
                            android:id="@+id/searchClear"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="end|center_vertical"
                            android:background="@drawable/ripple_icon_circle"
                            android:contentDescription="@string/button_clear_search"
                            android:padding="12dp"
                            android:visibility="gone"
                            app:srcCompat="@drawable/ic_close"
                            app:tint="?attr/colorOnSurface"
                            tools:visibility="visible" />

                    </FrameLayout>

                </LinearLayout>

                <!-- Manage mode: close, how many are selected, and what to do with them -->
                <LinearLayout
                    android:id="@+id/appBarSelection"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageButton
                        android:id="@+id/selectionClose"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/button_close_selection"
                        app:srcCompat="@drawable/ic_close"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/selectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Comet.TitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="2 selected" />

                    <ImageButton
                        android:id="@+id/selectionAll"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/button_select_all"
                        app:srcCompat="@drawable/ic_select_all"
                        app:tint="?attr/colorOnSurface" />

                    <ImageButton
                        android:id="@+id/selectionTags"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/button_tag_selected"
                        app:srcCompat="@drawable/ic_tag"
                        app:tint="@color/selection_action" />

                    <ImageButton
                        android:id="@+id/selectionDelete"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/button_remove_selected"
                        app:srcCompat="@drawable/ic_delete_outline"
                        app:tint="@color/selection_action_destructive" />

                </LinearLayout>

            </FrameLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- While screenshots are allowed (Settings > Security): until when, and a way to stop -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/screenshotBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_side_margin"
            android:layout_marginEnd="@dimen/card_side_margin"
            android:layout_marginBottom="@dimen/space_xs"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSecondaryContainer"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_xs">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_eye"
                    app:tint="?attr/colorOnSecondaryContainer" />

                <TextView
                    android:id="@+id/screenshotBannerText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Comet.BodyMedium"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    tools:text="Screenshots on until 5:45 PM" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/screenshotBannerOff"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="@dimen/space_sm"
                    android:text="@string/main_screenshots_turn_off"
                    android:textColor="?attr/colorOnSecondaryContainer" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cardList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_xs"
            android:scrollbars="none" />

        <include
            android:id="@+id/emptyState"
            layout="@layout/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <!-- Docked bottom bar: flush with the window bottom, notched for the add button; the view is
         bottom_bar_raise taller than the bar, for its shadow -->
    <com.gigabytedevelopersinc.app.cometOTP.View.NotchedBottomBar
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:barColor="?attr/colorBottomBar"
        app:barLineColor="?attr/colorBottomBarLine"
        app:barLineWidth="1dp"
        app:barNotchCornerRadius="@dimen/fab_notch_corner_radius"
        app:barNotchRadius="@dimen/fab_notch_radius"
        app:barRaise="@dimen/bottom_bar_raise"
        app:barShadowColor="?attr/colorBottomBarShadow"
        app:barShadowRadius="@dimen/bottom_bar_shadow_radius">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_bar_height"
            android:layout_marginTop="@dimen/bottom_bar_raise">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuButton"
                style="@style/Widget.Comet.BarIcon"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/bar_icon_margin"
                android:contentDescription="@string/button_main_menu"
                app:icon="@drawable/ic_bar_menu" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/bar_icon_margin"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/searchButton"
                    style="@style/Widget.Comet.BarIcon"
                    android:layout_marginEnd="@dimen/bar_icon_gap"
                    android:contentDescription="@string/menu_main_search"
                    app:icon="@drawable/ic_bar_search" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sortButton"
                    style="@style/Widget.Comet.BarIcon"
                    android:contentDescription="@string/menu_main_sort"
                    app:icon="@drawable/ic_bar_sort" />

            </LinearLayout>

        </FrameLayout>

    </com.gigabytedevelopersinc.app.cometOTP.View.NotchedBottomBar>

    <!-- Centred on the bar's top edge; the bottom margin is set from the window insets -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        style="@style/Widget.Comet.Fab"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|center_horizontal"
        android:contentDescription="@string/button_add"
        app:elevation="6dp"
        app:fabCustomSize="@dimen/fab_size"
        app:maxImageSize="@dimen/icon_size"
        app:srcCompat="@drawable/ic_add"
        app:tint="?attr/colorOnPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
