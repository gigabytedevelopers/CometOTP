<?xml version="1.0" encoding="utf-8"?>
<!-- Import from an app's export file: how to export there, then a button to choose the file.
     The title, heading and steps are filled in from the ImportSource; the steps are
     item_import_step rows. A source that is information only hides the button. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sheet_side_padding"
        android:paddingEnd="@dimen/sheet_side_padding"
        android:paddingBottom="@dimen/space_lg">

        <View style="@style/Widget.Comet.SheetHandle" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_sm">

            <!-- Kept clear of the close button on both sides so the title stays centred. -->
            <TextView
                android:id="@+id/importTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"
                android:gravity="center"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Comet.SheetTitle"
                tools:text="Import from Aegis" />

            <ImageButton
                android:id="@+id/sheetClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@android:string/cancel"
                app:srcCompat="@drawable/ic_close"
                app:tint="?attr/colorOnSurface" />

        </FrameLayout>

        <!-- From the app to CometOTP: the app's logo (or its initial), an arrow, CometOTP's icon.
             One description for the three, set with the app's name. -->
        <LinearLayout
            android:id="@+id/importFlow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sheet_header_gap"
            android:gravity="center_vertical"
            android:importantForAccessibility="yes"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/import_flow_icon_size"
                android:layout_height="@dimen/import_flow_icon_size"
                android:background="@drawable/bg_issuer_icon">

                <ImageView
                    android:id="@+id/importSourceLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_thumbnail_tile"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

            </FrameLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_md"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_arrow_forward"
                app:tint="?attr/colorOnSurfaceVariant" />

            <FrameLayout
                android:layout_width="@dimen/import_flow_icon_size"
                android:layout_height="@dimen/import_flow_icon_size"
                android:background="@drawable/bg_issuer_icon">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_thumbnail_tile"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_logo_mark"
                    app:tint="?attr/colorPrimary" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/importSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_header_gap"
            android:background="@drawable/bg_info_panel"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/importStepsHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Comet.TitleSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="In Aegis" />

        </LinearLayout>

        <TextView
            android:id="@+id/importNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_field_gap"
            android:drawablePadding="@dimen/space_sm"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Comet.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_info_outline"
            app:drawableTint="?attr/colorOnSurfaceVariant"
            tools:text="An encrypted vault needs the password you set in Aegis."
            tools:visibility="visible" />

        <!-- An export file holds every secret in it: shown for sources read from a file -->
        <TextView
            android:id="@+id/importDeleteNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_field_gap"
            android:drawablePadding="@dimen/space_sm"
            android:gravity="center_vertical"
            android:text="@string/import_file_delete_note"
            android:textAppearance="@style/TextAppearance.Comet.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_delete_outline"
            app:drawableTint="?attr/colorOnSurfaceVariant"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importChooseFile"
            style="@style/Widget.Comet.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/sheet_section_gap"
            android:text="@string/import_file_choose"
            app:icon="@drawable/ic_file_document"
            app:iconGravity="textStart" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
