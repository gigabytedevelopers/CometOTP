<?xml version="1.0" encoding="utf-8"?>
<!-- One setting in a service's Info dialog: its name, then its value -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/info_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Comet.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Algorithm" />

    <TextView
        android:id="@+id/info_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.Comet.BodyLarge"
        android:textColor="?attr/colorOnSurface"
        tools:text="SHA1" />

</LinearLayout>
