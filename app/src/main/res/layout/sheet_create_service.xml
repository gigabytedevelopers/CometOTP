<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sheet_side_padding"
        android:paddingEnd="@dimen/sheet_side_padding"
        android:paddingBottom="@dimen/space_lg">

        <View style="@style/Widget.Comet.SheetHandle" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_sm">

            <!-- When editing: the settings that cannot change (type, algorithm, refresh time,
                 digits), opposite the close button -->
            <ImageButton
                android:id="@+id/manual_info"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/label_info"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_info_outline"
                app:tint="?attr/colorOnSurface"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/sheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/sheet_title_create_service"
                android:textAppearance="@style/TextAppearance.Comet.SheetTitle" />

            <ImageButton
                android:id="@+id/sheetClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@android:string/cancel"
                app:srcCompat="@drawable/ic_close"
                app:tint="?attr/colorOnSurface" />

        </FrameLayout>

        <!-- Icon preview / picker -->
        <FrameLayout
            android:id="@+id/manual_icon_frame"
            android:layout_width="@dimen/thumbnail_tile_size"
            android:layout_height="@dimen/thumbnail_tile_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sheet_header_gap"
            android:background="@drawable/bg_thumbnail_placeholder"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/manual_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/menu_popup_change_image"
                android:padding="12dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_logo_mark" />

            <ImageView
                android:id="@+id/manual_icon_add"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_add"
                app:tint="@color/neutral_0" />

        </FrameLayout>

        <!-- Key (secret) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/manual_secret_layout"
            style="@style/Widget.Comet.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_field_gap"
            android:hint="@string/label_key"
            app:endIconContentDescription="@string/help_key"
            app:endIconDrawable="@drawable/ic_info_outline"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/manual_secret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/droid_sans_mono_slashed"
                android:inputType="textNoSuggestions|textMultiLine"
                android:maxLines="3" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- When editing: the key, which cannot change, hidden until revealed, with the service's
             QR code beside it -->
        <FrameLayout
            android:id="@+id/manual_secret_view_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_field_gap"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/manual_secret_view_field"
                style="@style/Widget.Comet.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/label_key"
                app:endIconContentDescription="@string/action_show_key"
                app:endIconDrawable="@drawable/ic_visibility_visible"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manual_secret_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/droid_sans_mono_slashed"
                    android:inputType="none"
                    android:maxLines="3"
                    android:paddingStart="@dimen/space_md"
                    android:paddingEnd="@dimen/field_second_icon_room"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textIsSelectable="true"
                    tools:text="JBSWY3DPEHPK3PXP" />

            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/manual_secret_qr"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginTop="@dimen/field_icon_offset"
                android:layout_marginEnd="@dimen/field_second_icon_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_popup_show_qr_code"
                app:srcCompat="@drawable/ic_qr_code"
                app:tint="?attr/colorOnSurfaceVariant" />

        </FrameLayout>

        <!-- Type -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/manual_type_layout"
            style="@style/Widget.Comet.TextInput.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_field_gap"
            android:hint="@string/label_type">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/manual_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textAppearance="@style/TextAppearance.Comet.BodyLarge"
                tools:text="TOTP (Time Based OTP)" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Issuer -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Comet.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_field_gap"
            android:hint="@string/label_issuer">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/manual_issuer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Label -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Comet.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_field_gap"
            android:hint="@string/hint_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/manual_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- When editing: whether the card shows the service's brand icon or its initials, and
             how the initials look -->
        <LinearLayout
            android:id="@+id/manual_personalisation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_field_gap"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field_outline"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="@dimen/space_sm">

            <LinearLayout
                android:id="@+id/manual_choice_brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">

                <FrameLayout
                    android:id="@+id/manual_choice_brand_tile"
                    android:layout_width="@dimen/choice_tile_size"
                    android:layout_height="@dimen/choice_tile_size"
                    android:background="@drawable/bg_choice_tile"
                    android:duplicateParentState="true">

                    <ImageView
                        android:id="@+id/manual_choice_brand_picture"
                        android:layout_width="@dimen/choice_picture_size"
                        android:layout_height="@dimen/choice_picture_size"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_thumbnail_tile"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/personalise_brand_icon"
                    android:textAppearance="@style/TextAppearance.Comet.LabelLarge"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/manual_choice_initials"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">

                <FrameLayout
                    android:id="@+id/manual_choice_initials_tile"
                    android:layout_width="@dimen/choice_tile_size"
                    android:layout_height="@dimen/choice_tile_size"
                    android:background="@drawable/bg_choice_tile"
                    android:duplicateParentState="true">

                    <ImageView
                        android:id="@+id/manual_choice_initials_picture"
                        android:layout_width="@dimen/choice_picture_size"
                        android:layout_height="@dimen/choice_picture_size"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_thumbnail_tile"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/personalise_initials"
                    android:textAppearance="@style/TextAppearance.Comet.LabelLarge"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/manual_change_icon"
                style="@style/Widget.Comet.NavRow"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/personalise_change_icon"
                app:drawableStartCompat="@drawable/ic_image_outline" />

            <TextView
                android:id="@+id/manual_edit_initials"
                style="@style/Widget.Comet.NavRow"
                android:text="@string/personalise_edit_initials"
                app:drawableStartCompat="@drawable/ic_edit_pen" />

            <LinearLayout
                android:id="@+id/manual_badge_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/nav_row_height"
                android:background="@drawable/bg_nav_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_lg">

                <!-- In a 24dp slot, so the dot lines up with the icons above it -->
                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp">

                    <View
                        android:id="@+id/manual_badge_dot"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_color_dot" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/personalise_badge_colour"
                    android:textAppearance="@style/TextAppearance.Comet.LabelLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/manual_badge_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.Comet.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Automatic" />

                <ImageView
                    android:id="@+id/manual_badge_chevron"
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_marginStart="@dimen/space_xs"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_expand_more"
                    app:tint="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/manual_badge_palette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Tags -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Comet.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_field_gap"
            android:hint="@string/label_tag_optional"
            app:endIconContentDescription="@string/label_tags"
            app:endIconDrawable="@drawable/ic_tag"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/manual_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Whether browsers paired with CometOTP get this service. Only while browser sync is
             available (R.bool.browser_sync_available). -->
        <LinearLayout
            android:id="@+id/manual_browser_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_field_gap"
            android:background="@drawable/bg_field_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/nav_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_sm"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/manual_browser_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/browser_extension"
                    android:textAppearance="@style/TextAppearance.Comet.TitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/manual_browser_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Comet.Caption"
                    tools:text="@string/browser_extension_on" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/manual_browser_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md" />

        </LinearLayout>

        <!-- HOTP counter (only for HOTP) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/manual_layout_counter"
            style="@style/Widget.Comet.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_field_gap"
            android:hint="@string/label_counter"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/manual_counter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Advanced options toggle -->
        <TextView
            android:id="@+id/dialog_expand_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/sheet_field_gap"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="@dimen/space_sm"
            android:gravity="center_vertical"
            android:text="@string/label_advanced"
            android:textAppearance="@style/TextAppearance.Comet.LabelLarge"
            android:textColor="?attr/colorOnSurface"
            app:drawableEndCompat="@drawable/ic_expand_more"
            app:drawableTint="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/dialog_expand_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/manual_layout_period"
                style="@style/Widget.Comet.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/label_period"
                app:endIconContentDescription="@string/help_period"
                app:endIconDrawable="@drawable/ic_info_outline"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manual_period"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Comet.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sheet_field_gap"
                android:hint="@string/label_digits"
                app:endIconContentDescription="@string/help_digits"
                app:endIconDrawable="@drawable/ic_info_outline"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manual_digits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/manual_algorithm_layout"
                style="@style/Widget.Comet.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sheet_field_gap"
                android:hint="@string/label_algorithm">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/manual_algorithm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textAppearance="@style/TextAppearance.Comet.BodyLarge"
                    tools:text="SHA1" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_section_gap">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manual_submit"
                style="@style/Widget.Comet.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:enabled="false"
                android:text="@string/button_create" />

        </FrameLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
