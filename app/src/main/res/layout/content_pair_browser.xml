<?xml version="1.0" encoding="utf-8"?>
<!-- Pairing a browser (PairBrowserActivity): one step at a time, with its actions at the bottom. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:orientation="vertical"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_lg">

            <!-- The computer, with a badge once it is over -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="start|bottom"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_computer"
                    app:tint="?attr/colorPrimary" />

                <ImageView
                    android:id="@+id/pair_badge"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="end|top"
                    android:background="@drawable/bg_badge_success"
                    android:contentDescription="@null"
                    android:padding="5dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_check_mark"
                    app:tint="@color/neutral_0"
                    tools:visibility="visible" />

            </FrameLayout>

            <TextView
                android:id="@+id/pair_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Comet.HeadlineSmall"
                tools:text="Check the code" />

            <TextView
                android:id="@+id/pair_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Comet.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Pair only if Chrome on macOS shows this same code." />

            <!-- The six digits both sides show (protocol §3.2) -->
            <TextView
                android:id="@+id/pair_sas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_pair_code"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.Comet.Code"
                android:textSize="40sp"
                android:visibility="gone"
                tools:text="135 557"
                tools:visibility="visible" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/pair_progress"
                style="@style/Widget.Comet.Progress.Wavy"
                android:layout_marginTop="@dimen/space_lg"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pair_primary"
            style="@style/Widget.Comet.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:visibility="gone"
            tools:text="Pair"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pair_secondary"
            style="@style/Widget.Comet.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@android:string/cancel" />

    </LinearLayout>

</LinearLayout>
