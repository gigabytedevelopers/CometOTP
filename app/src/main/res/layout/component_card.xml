<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_view"
    style="@style/Widget.Comet.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_md"
    android:layout_marginEnd="@dimen/space_md"
    android:layout_marginTop="@dimen/space_xs"
    android:layout_marginBottom="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true"
    app:cardPreventCornerOverlap="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp">

        <!-- Coloured tag bar on the leading edge (visible when the entry is tagged) -->
        <View
            android:id="@+id/tagBar"
            android:layout_width="@dimen/tag_bar_width"
            android:layout_height="0dp"
            android:background="?attr/colorPrimary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <FrameLayout
            android:id="@+id/thumbnailFrame"
            android:layout_width="@dimen/issuer_icon_size"
            android:layout_height="@dimen/issuer_icon_size"
            android:layout_marginStart="@dimen/space_md"
            android:background="@drawable/bg_issuer_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/thumbnailImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/bg_thumbnail_tile"
                android:contentDescription="@null"
                android:padding="6dp"
                android:scaleType="fitCenter"
                tools:src="@mipmap/ic_launcher" />

        </FrameLayout>

        <!-- Issuer + tag chip -->
        <LinearLayout
            android:id="@+id/issuerRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/trailingGroup"
            app:layout_constraintStart_toEndOf="@id/thumbnailFrame"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textViewIssuer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Comet.Caption"
                tools:text="Facebook" />

            <TextView
                android:id="@+id/textViewTags"
                style="@style/Widget.Comet.TagChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:visibility="gone"
                tools:text="Important"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Token (visible) -->
        <LinearLayout
            android:id="@+id/valueLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/trailingGroup"
            app:layout_constraintStart_toEndOf="@id/thumbnailFrame"
            app:layout_constraintTop_toBottomOf="@id/issuerRow">

            <TextView
                android:id="@+id/valueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Comet.Code"
                android:textDirection="ltr"
                tools:text="4119 3435" />

            <TextView
                android:id="@+id/valueTextPrev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.Comet.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textDirection="ltr"
                android:visibility="gone"
                tools:text="220 671"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Token (hidden / tap to reveal) -->
        <LinearLayout
            android:id="@+id/coverLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/trailingGroup"
            app:layout_constraintStart_toEndOf="@id/thumbnailFrame"
            app:layout_constraintTop_toBottomOf="@id/issuerRow">

            <ImageView
                android:id="@+id/coverImg"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="@dimen/space_sm"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_eye_off"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/label_hidden"
                android:text="@string/bullet_placeholder"
                android:textAppearance="@style/TextAppearance.Comet.Code"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Account label -->
        <TextView
            android:id="@+id/textViewLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_marginBottom="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Comet.Caption"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/trailingGroup"
            app:layout_constraintStart_toEndOf="@id/thumbnailFrame"
            app:layout_constraintTop_toBottomOf="@id/valueLayout"
            tools:text="mynameisthis@email.com" />

        <!-- Trailing: HOTP counter, countdown ring, copy, overflow -->
        <LinearLayout
            android:id="@+id/trailingGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/counterLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_counter_symbol"
                    android:textAppearance="@style/TextAppearance.Comet.LabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textAppearance="@style/TextAppearance.Comet.LabelMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="12" />
            </LinearLayout>

            <com.gigabytedevelopersinc.app.cometOTP.View.CountdownRingView
                android:id="@+id/cardCountdown"
                android:layout_width="@dimen/countdown_size"
                android:layout_height="@dimen/countdown_size"
                android:layout_marginStart="@dimen/space_sm"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/copyButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/button_card_copy"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_copy"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/button_card_options"
                app:srcCompat="@drawable/ic_more_vert"
                app:tint="?attr/colorOnSurface" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
