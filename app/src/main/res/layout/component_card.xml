<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_view"
    style="@style/Widget.Comet.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/card_side_margin"
    android:layout_marginEnd="@dimen/card_side_margin"
    android:layout_marginTop="@dimen/card_vertical_margin"
    android:layout_marginBottom="@dimen/card_vertical_margin"
    android:clickable="true"
    android:focusable="true"
    app:cardPreventCornerOverlap="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/card_min_height">

        <!-- Coloured tag bar on the leading edge (visible when the entry is tagged) -->
        <View
            android:id="@+id/tagBar"
            android:layout_width="@dimen/tag_bar_width"
            android:layout_height="0dp"
            android:background="?attr/colorPrimary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <FrameLayout
            android:id="@+id/thumbnailFrame"
            android:layout_width="@dimen/issuer_icon_size"
            android:layout_height="@dimen/issuer_icon_size"
            android:layout_marginStart="@dimen/space_md"
            android:background="@drawable/bg_issuer_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/thumbnailImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/bg_thumbnail_tile"
                android:contentDescription="@null"
                android:padding="6dp"
                android:scaleType="fitCenter"
                tools:src="@mipmap/ic_launcher" />

        </FrameLayout>

        <!-- Issuer and tag, token (or its cover while hidden) and account label, stacked in one
             column centred on the card. Only the lines that are showing take up room, so the text
             stays centred against the icon with or without an issuer or a label: anchored to the
             top, a card missing either had its text sitting above the icon. -->
        <LinearLayout
            android:id="@+id/textColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_sm"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/trailingGroup"
            app:layout_constraintStart_toEndOf="@id/thumbnailFrame"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Issuer + tag chip -->
            <LinearLayout
                android:id="@+id/issuerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textViewIssuer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Comet.Caption"
                    tools:text="Facebook" />

                <TextView
                    android:id="@+id/textViewTags"
                    style="@style/Widget.Comet.TagChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:visibility="gone"
                    tools:text="Important"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- The token, and over it while hidden (tap to reveal) the cover; the hidden token
                 keeps its room, so the card is the same height either way -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Token (visible) -->
                <LinearLayout
                    android:id="@+id/valueLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/valueText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/token_line_height"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Comet.Code"
                        android:textDirection="ltr"
                        app:autoSizeMaxTextSize="30sp"
                        app:autoSizeMinTextSize="14sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        tools:text="4119 3435" />

                    <!-- The previous token and, while the current one is about to expire, the next
                         one in a pill: on their own line, so that neither takes room from the token -->
                    <LinearLayout
                        android:id="@+id/otherTokensRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/valueTextPrev"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Comet.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textDirection="ltr"
                            android:visibility="gone"
                            tools:text="220 671"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/valueTextNext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_field"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:textAppearance="@style/TextAppearance.Comet.CodeNext"
                            android:textDirection="ltr"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_next_token"
                            tools:text="568 202"
                            tools:visibility="visible" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Token (hidden / tap to reveal) -->
                <LinearLayout
                    android:id="@+id/coverLayout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/token_line_height"
                    android:layout_gravity="top"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/coverImg"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_eye_off"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/label_hidden"
                        android:text="@string/bullet_placeholder"
                        android:textAppearance="@style/TextAppearance.Comet.Code"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </FrameLayout>

            <!-- Account label -->
            <TextView
                android:id="@+id/textViewLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Comet.Caption"
                tools:text="mynameisthis@email.com" />

        </LinearLayout>

        <!-- Trailing: HOTP counter, countdown ring, then options over copy -->
        <LinearLayout
            android:id="@+id/trailingGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/counterLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_counter_symbol"
                    android:textAppearance="@style/TextAppearance.Comet.LabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textAppearance="@style/TextAppearance.Comet.LabelMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="12" />
            </LinearLayout>

            <com.gigabytedevelopersinc.app.cometOTP.View.CountdownRingView
                android:id="@+id/cardCountdown"
                android:layout_width="@dimen/countdown_size"
                android:layout_height="@dimen/countdown_size"
                android:layout_marginStart="@dimen/space_sm"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Copies the token; left out while a tap on the card copies (EntryViewHolder).
                 The card's other actions open with a long press. -->
            <ImageButton
                android:id="@+id/copyButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/button_card_copy"
                android:padding="9dp"
                app:srcCompat="@drawable/ic_copy"
                app:tint="?attr/colorOnSurfaceVariant" />

            <!-- Manage mode: whether the card is selected (the card itself announces it), and
                 a handle to drag it by while the list is in its own order -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/selectCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:minWidth="40dp"
                android:minHeight="40dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/dragHandle"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:contentDescription="@string/button_drag_to_reorder"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_drag_handle"
                app:tint="?attr/colorOnSurfaceVariant"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
