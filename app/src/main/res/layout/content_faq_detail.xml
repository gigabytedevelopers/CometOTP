<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:id="@+id/faq_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Comet.TitleLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="What is CometOTP" />

        <TextView
            android:id="@+id/faq_detail_updated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Comet.Caption"
            tools:text="Last updated: 21st March 2025" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    app:srcCompat="@drawable/ic_logo_stacked"
                    app:tint="?attr/colorOnPrimary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/faq_detail_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:lineSpacingMultiplier="1.3"
            android:textAppearance="@style/TextAppearance.Comet.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="CometOTP is a simple and free application..." />

        <!-- Only for an answer with links (faq_link_names): pages to read on -->
        <LinearLayout
            android:id="@+id/faq_detail_links"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/faq_links_title"
                android:textAppearance="@style/TextAppearance.Comet.TitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <!-- Out by the rows' own start padding, so their icons line up with the text -->
            <LinearLayout
                android:id="@+id/faq_detail_link_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/faq_link_outset"
                android:layout_marginEnd="@dimen/faq_link_outset"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/faq_links_note"
                android:textAppearance="@style/TextAppearance.Comet.Caption" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
