<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_lg">

        <!-- On / off -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scheduled_backup_label_enabled"
                    android:textAppearance="@style/TextAppearance.Comet.TitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/scheduled_backup_desc_enabled"
                    android:textAppearance="@style/TextAppearance.Comet.Caption" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sched_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md" />

        </LinearLayout>

        <View style="@style/Widget.Comet.Divider" />

        <!-- Schedule -->
        <TextView
            style="@style/Widget.Comet.SectionHeader"
            android:text="@string/scheduled_backup_section_schedule" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:text="@string/scheduled_backup_label_frequency"
            android:textAppearance="@style/TextAppearance.Comet.TitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Comet.TextInput.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_label_gap"
            app:hintEnabled="false">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/sched_frequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Comet.BodyLarge"
                android:textSize="15sp"
                tools:text="Daily" />

        </com.google.android.material.textfield.TextInputLayout>

        <include
            android:id="@+id/row_time"
            layout="@layout/item_setting_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" />

        <!-- Destination -->
        <TextView
            style="@style/Widget.Comet.SectionHeader"
            android:text="@string/scheduled_backup_section_destination" />

        <include
            android:id="@+id/row_folder"
            layout="@layout/item_setting_row" />

        <View style="@style/Widget.Comet.Divider" />

        <include
            android:id="@+id/row_password"
            layout="@layout/item_setting_row" />

        <View style="@style/Widget.Comet.Divider" />

        <!-- Options -->
        <TextView
            style="@style/Widget.Comet.SectionHeader"
            android:text="@string/scheduled_backup_section_options" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:text="@string/scheduled_backup_label_keep"
            android:textAppearance="@style/TextAppearance.Comet.TitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:text="@string/scheduled_backup_desc_keep"
            android:textAppearance="@style/TextAppearance.Comet.Caption" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Comet.TextInput.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_label_gap"
            app:hintEnabled="false">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/sched_keep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Comet.BodyLarge"
                android:textSize="15sp"
                tools:text="5" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sched_charging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="56dp"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:text="@string/scheduled_backup_label_charging"
            android:textAppearance="@style/TextAppearance.Comet.TitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sched_notify_success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:text="@string/scheduled_backup_label_notify_success"
            android:textAppearance="@style/TextAppearance.Comet.TitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <!-- Status -->
        <TextView
            style="@style/Widget.Comet.SectionHeader"
            android:text="@string/scheduled_backup_section_status" />

        <TextView
            android:id="@+id/sched_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:lineSpacingExtra="4dp"
            android:textAppearance="@style/TextAppearance.Comet.BodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Last backup: 28 Sep, 02:04\nNext backup: around 29 Sep, 02:00" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sheet_section_gap">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sched_backup_now"
                style="@style/Widget.Comet.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/scheduled_backup_button_now" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/sched_progress"
                style="@style/Widget.Comet.Progress.OnPrimary"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
